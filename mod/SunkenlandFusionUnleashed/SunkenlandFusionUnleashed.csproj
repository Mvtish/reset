      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Sunkenland\Sunkenland_Data\Managed\Fusion.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageSource Include="https://nuget.bepinex.dev/v3/index.json" />
  </ItemGroup>

</Project>
